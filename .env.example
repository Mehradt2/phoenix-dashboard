DOMAIN=qc.example.org
POSTGRES_DB=kuleposhti
POSTGRES_USER=kuleposhti
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
BOOTSTRAP_ADMIN_EMAIL=qc-admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_16_PLUS_CHARS
SESSION_HOURS=12
DB_POOL_MAX=10
KP_RELEASE=team-docker-v1

# Local ASR provider (Oganson)
OGANSON_BASE_URL=http://host.docker.internal:9000
OGANSON_SHARED_TOKEN=CHANGE_ME_RANDOM_SHARED_SECRET
OGANSON_HEALTH_PATH=/health
OGANSON_RESULT_PATH=/api/transcripts
