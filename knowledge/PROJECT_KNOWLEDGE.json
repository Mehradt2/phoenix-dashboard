{
  "product": "KulePoshti",
  "purpose": "Persian conversation quality-control operations system",
  "source_branch": "kuleposhti-local-text-intelligence-v2",
  "public_runtime": "https://mehradt2.github.io/phoenix-dashboard/",
  "runtimes": {
    "browser_local": {
      "storage": "Encrypted IndexedDB",
      "audio_cloud": false,
      "shared_db": false
    },
    "team_docker": {
      "web": "React/Nginx",
      "api": "Node 22/Express",
      "database": "PostgreSQL 16",
      "tls": "Caddy",
      "audio_cloud": false,
      "shared_db": true
    },
    "windows_target": {
      "shell": "Tauri/Rust",
      "database": "SQLite WAL",
      "asr": "whisper.cpp",
      "status": "separate evidence track"
    },
    "local_text_v2": {
      "stt_provider": "Oganson via adapter",
      "text_brain": "FastAPI/Python Persian-first",
      "api": "Node 22/Express",
      "database": "PostgreSQL 16",
      "mode": "local/on-prem",
      "paid_ai_api": false,
      "internet_required_at_runtime": false
    }
  },
  "domains": [
    "physician",
    "sampler",
    "voc"
  ],
  "invariants": [
    "Evidence before QC pass",
    "Critical finding blocks normal auto-approval",
    "AI copilot cannot mutate deterministic QC score",
    "Audio raw is never sent to team API",
    "Audit is append-only",
    "Rule packs are versioned",
    "No paid ASR or LLM API in critical path"
  ],
  "documentation_entry": "docs/00_INDEX_FA.md",
  "docker_entry": "docker-compose.local-v2.yml",
  "database_migrations": "server/migrations",
  "api_source": "server/src",
  "ops_scripts": "ops",
  "ci": [
    ".github/workflows/kuleposhti-pages.yml",
    ".github/workflows/kuleposhti-docker.yml",
    ".github/workflows/kuleposhti-local-text-intelligence-v2.yml"
  ],
  "release_family": "qc-local-text-v2.0-mvp",
  "rule_packs": {
    "sampler": "sampler-conversation-qc-1.1.0",
    "physician": "physician-qc-2.0.0",
    "physician_operational": "physician-ops-2026-09-21",
    "sampler_operational": "sampler-ops-2026-09-21",
    "voc": "voc-qc-1.0.0-candidate",
    "voc_operational": "voc-ops-2026-10-07"
  },
  "processing": {
    "browser_asr_policy": "browser-asr-policy-1.2.0",
    "model_timeout_ms": 150000,
    "safe_fallback": "onnx-community/whisper-tiny",
    "manual_transcript_fallback": true,
    "retry": true,
    "false_success_blocked": true,
    "auto_mode": "WebGPU→whisper-small; no-WebGPU→whisper-tiny",
    "case_pipeline_gate": "Upload→ASR/manual→QC→encrypted persist→Review→Evidence→Profile→Report→Audit",
    "v2_pipeline": "Oganson→Canonical Transcript→Persian Normalization→Medical Entity/Negation/VOC→Domain QC→Human Review→Profiles/History/Reports",
    "identity_key": "trusted subject_id; never name-only",
    "date_policy": "store UTC ISO; filter/display Gregorian or Jalali"
  },
  "profiles": {
    "individual_drilldown": true,
    "failure_pareto": true,
    "call_history": true,
    "physician_short_call_signals": true,
    "external_operational_data": "explicitly gated until real DB/CRM connection",
    "physician_pvq_catalog": "DOC-009 / PVQ-026..040",
    "sampler_rule_pack": "C01..C09 + workflow 70/30"
  },
  "recovery": {
    "ci_source_bundle": true,
    "includes": [
      "source",
      "docs",
      "docker",
      "server",
      "ops",
      "migrations"
    ],
    "artifact_retention_days": 90,
    "required_every_release": [
      "source",
      "docs",
      "docker",
      "migrations",
      "tests",
      "knowledge snapshot",
      "Oganson contract",
      "text-brain model manifest",
      "Gold benchmark evidence"
    ]
  },
  "documentation_v2": [
    "docs/v2/PRD_LOCAL_TEXT_INTELLIGENCE_V2_FA.md",
    "docs/v2/ARCHITECTURE_OGANSON_LOCAL_V2_FA.md",
    "docs/v2/NLP_BENCHMARK_PERSIAN_MEDICAL_V2_FA.md",
    "docs/v2/MVP_ACCEPTANCE_V2_FA.md",
    "docs/adr/ADR-002-oganson-adapter.md"
  ]
}